{
  "rules": {
    ".read": "auth != null",
    ".write": "auth != null",
    "users": {
      "$uid": {
        ".read": "auth != null",
        ".write": "$uid === auth.uid || root.child('users').child(auth.uid).child('role').val() === 'admin'"
      }
    },
    "ambulances": {
      ".indexOn": ["status", "type"],
      "$ambId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "dispatches": {
      ".indexOn": ["status", "patientId", "ambulanceId"],
      "$dspId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "hospitals": {
      ".indexOn": ["city"],
      "$hospId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "checklists": {
      ".indexOn": ["ambulanceId", "status"],
      "$chkId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    }
  }
}
